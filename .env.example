# 나무증권(NH투자증권) PLUG Open API 환경변수 설정
# 복사하여 .env 로 이름을 변경 후 앱 키 를 입력하세요.

# 1. 운영 모드 설정 (가상 투자 우선 원칙)
# - PAPER: 자체 가상 투자 (실제 주문 0원, 초기 시드 1,000만원/변경 가능)
# - MOCK : 증권사 모의 투자 (moapi.nhplug.com:8443)
# - LIVE : 실제 실전 투자 (api.nhplug.com:8443)
TRADING_MODE=PAPER

# 실전 투자(LIVE) 전환 시 2중 확인 장치 (true 로 해야 LIVE 주문 가능)
CONFIRM_REAL_TRADING=false

# 2. API 자격증명 (발급: https://www.nhplug.com/intro 등 참고)
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=

# 3. 기본 환경 URL
# - 모의: https://moapi.nhplug.com:8443
# - 운영(실전): https://api.nhplug.com:8443
NHPLUG_BASE_URL=https://moapi.nhplug.com:8443

# 인증 토큰 발급 URL (운영 기준 - 모의/실전 투자 시에도 동일함)
NHPLUG_AUTH_URL=https://api.nhplug.com:8443

# 4. 기본 계좌번호 (옵션: 생략 시 /n2/acctinfo 등 환경에 맞게 코드 내 지정)
# NHPLUG_DEFAULT_ACCOUNT=12345678901

# 5. 호출 제한 및 토큰 캐시
NHPLUG_RATE_LIMIT=4             # REST 초당 호출 제한 (기본 4회, 최대 5회)
NHPLUG_TOKEN_CACHE=1            # 토큰 24시간 내 캐싱 사용 유무 (1=사용)

# ==========================================
# [추가] 자동매매 봇(Bot) 운영 핵심 설정
# ==========================================

# 6. 매매 대상 종목 설정
# 거래할 주식의 종목코드를 콤마(,)로 구분하여 입력 (예: 삼성전자, SK하이닉스)
TARGET_SYMBOLS=005930,000660

# 7. 매매 전략 및 리스크 관리 설정
BREAKOUT_K=0.5                  # 변동성 돌파 전략의 K상수 (0.1 ~ 1.0)
MAX_LOSS_PCT=0.02               # 최대 손절 비율 (0.02 = -2% 하락 시 자동 매도)

# 8. 시스템 및 웹 대시보드 설정
PORT=8000                       # FastAPI 웹 서버 접근 포트

# 9. 알림 설정 (옵션)
# 텔레그램 봇 토큰과 챗봇 ID를 입력하면 매매 시 알림 전송
# TELEGRAM_BOT_TOKEN=your_telegram_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id
