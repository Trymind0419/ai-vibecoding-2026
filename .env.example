# 나무증권(NH투자증권) PLUG Open API 환경설정 예시
# 복사하여 .env 로 이름을 변경한 뒤 실제 키 값을 입력하세요.

# 1. 운영 모드 설정 (가상 매매 우선 검증 원칙)
# - PAPER: 자체 가상 매매 (실제 주문 0원, 가상 시드 1,000만원으로 승률/안정성 검증)
# - MOCK : 나무증권 모의투자 서버 연동 (moapi.nhplug.com:8443)
# - LIVE : 실제 계좌 실전 매매 (api.nhplug.com:8443)
TRADING_MODE=PAPER

# 실전 매매(LIVE) 전환 시 2중 확인 안전장치 (true 로 설정해야 LIVE 주문 허용)
CONFIRM_REAL_TRADING=false

# 2. API 자격증명 (포털 https://www.nhplug.com/intro 에서 발급)
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=

# 3. 접속 환경 설정
# - 모의투자: https://moapi.nhplug.com:8443
# - 운영(실전): https://api.nhplug.com:8443
NHPLUG_BASE_URL=https://moapi.nhplug.com:8443

# ⚠️ 토큰 발급 URL (운영 전용 - 모의/가상 매매 시에도 그대로 유지)
NHPLUG_AUTH_URL=https://api.nhplug.com:8443

# 4. 기본 계좌번호 (선택 사항: 미입력 시 /n2/acctinfo 에서 환경에 맞게 자동 선택)
# NHPLUG_DEFAULT_ACCOUNT=12345678901

# 5. 호출 제한 및 보안 설정
NHPLUG_RATE_LIMIT=4             # REST 초당 호출 제한 (기본 4회, 상한 5회)
NHPLUG_TOKEN_CACHE=1            # 토큰 24시간 파일 캐시 사용 여부 (1=사용)
