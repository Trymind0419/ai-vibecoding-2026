# -*- coding: utf-8 -*-
"""나무증권(NHPLUG) 실제 연동 모듈"""
import logging
import random
from auto_trader.config import settings

logger = logging.getLogger(__name__)

class NamuhAutoTrader:
    def __init__(self):
        self.client = None
        self.is_connected = False
        self.positions = {}
        
        app_key = settings.NHPLUG_APP_KEY
        app_secret = settings.NHPLUG_APP_SECRET
        
        if not app_key or not app_secret or app_key == "YOUR_APP_KEY_HERE" or app_key == "":
            logger.warning("[NHPLUG] API 키가 설정되지 않아 시뮬레이션(안전) 모드로 작동합니다.")
            return

        try:
            import nhplug
            # 나무증권 OpenAPI 초기화 (실제 라이브러리 사용법에 맞게 구성)
            self.client = nhplug.Client(
                app_key=app_key, 
                app_secret=app_secret,
                is_paper=(settings.TRADING_MODE == "PAPER")
            )
            self.is_connected = True
            logger.info("[NHPLUG] 나무증권 API 연동 완료.")
        except ImportError:
            logger.error("[NHPLUG] 'nhplug' 패키지가 설치되지 않았습니다. (pip install nhplug)")
        except Exception as e:
            logger.error(f"[NHPLUG] 연결 실패: {e}")

    def get_balance(self):
        if self.is_connected and self.client:
            try:
                # 실제 잔고 조회
                account_info = self.client.account.get_balance()
                return int(account_info.get("total_asset", 10000000))
            except Exception as e:
                logger.error(f"실제 잔고 조회 실패: {e}")
        return 10000000 # Fallback 가짜 잔고

    def order_buy(self, symbol, price, qty):
        if self.is_connected and self.client:
            try:
                # 실제 매수 주문
                res = self.client.order.buy(symbol=symbol, price=price, qty=qty, order_type="LIMIT")
                return res.get("success", False)
            except Exception as e:
                logger.error(f"실제 매수 주문 실패: {e}")
                return False
        # Fallback 처리
        self.positions[symbol] = self.positions.get(symbol, 0) + qty
        return True

    def order_sell(self, symbol, price, qty):
        if self.is_connected and self.client:
            try:
                # 실제 매도 주문
                res = self.client.order.sell(symbol=symbol, price=price, qty=qty, order_type="LIMIT")
                return res.get("success", False)
            except Exception as e:
                logger.error(f"실제 매도 주문 실패: {e}")
                return False
        # Fallback 처리
        if self.positions.get(symbol, 0) >= qty:
            self.positions[symbol] -= qty
            if self.positions[symbol] == 0:
                del self.positions[symbol]
            return True
        return False

    def get_quotes(self, tickers: list):
        """다중 종목 실시간 시세 조회"""
        if self.is_connected and self.client:
            try:
                # 실제 시세 벌크 조회
                quotes = []
                for t in tickers:
                    # 종목별 현재가 API 호출
                    data = self.client.market.get_current_price(t["symbol"])
                    quotes.append({
                        "name": t["name"],
                        "symbol": t["symbol"],
                        "price": data.get("price", t["price"]),
                        "change": data.get("change_rate", 0.0)
                    })
                return quotes
            except Exception as e:
                logger.error(f"실제 시세 조회 실패: {e}")
        
        # 시뮬레이션 모드 (변동성 적용)
        results = []
        for t in tickers:
            base_price = t["price"]
            change = round(random.uniform(-3.5, 3.5), 2)
            current_price = int(base_price * (1 + change / 100))
            results.append({
                "name": t["name"],
                "symbol": t["symbol"],
                "price": current_price,
                "change": change
            })
        return results
