@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;700&display=swap');

body {
    margin: 0;
    padding: 0;
    font-family: 'Noto Sans KR', sans-serif;
    color: #e0e0e0;
    /* 에메랄드 + 어두운 빛반사 배경 */
    background: radial-gradient(circle at 10% 20%, rgba(46, 204, 113, 0.15), transparent 60%),
                radial-gradient(circle at 90% 80%, rgba(26, 188, 156, 0.15), transparent 50%),
                linear-gradient(135deg, #0f171e, #1a252c);
    background-attachment: fixed;
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden; /* HTS처럼 꽉 찬 화면 */
}

.obsidian-panel {
    background: rgba(15, 20, 25, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5), inset 0 1px 2px rgba(255, 255, 255, 0.15);
}

/* Header */
.top-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 30px;
    border-radius: 0;
    border-bottom: 1px solid rgba(46, 204, 113, 0.3);
}

.top-header h1 {
    margin: 0;
    font-size: 1.4rem;
    background: linear-gradient(90deg, #2ecc71, #1abc9c);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.top-header h1 span {
    font-size: 0.9rem;
    color: #888;
    -webkit-text-fill-color: #888;
    margin-left: 10px;
}

/* Status */
.status-indicator { display: flex; align-items: center; gap: 10px; font-weight: bold; }
.status-dot { width: 12px; height: 12px; border-radius: 50%; box-shadow: 0 0 8px rgba(0,0,0,0.5); }
.status-dot.on { background: #2ecc71; box-shadow: 0 0 10px #2ecc71; }
.status-dot.off { background: #e74c3c; box-shadow: 0 0 10px #e74c3c; }

/* HTS Layout */
.hts-container {
    display: grid;
    grid-template-columns: 320px 1fr 320px;
    gap: 15px;
    padding: 15px;
    flex: 1;
    overflow: hidden;
    margin-bottom: 40px; /* 티커 공간 확보 */
}

.hts-panel {
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.panel-header {
    background: rgba(0,0,0,0.4);
    padding: 12px 15px;
    font-weight: bold;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    color: #2ecc71; /* 에메랄드 포인트 */
}

/* 좌측 관심종목 테이블 */
.table-container {
    flex: 1;
    overflow-y: auto;
}
.hts-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
}
.hts-table th, .hts-table td {
    padding: 10px 12px;
    text-align: right;
    border-bottom: 1px solid rgba(255,255,255,0.05);
}
.hts-table th {
    text-align: right;
    color: #888;
    background: rgba(0,0,0,0.6);
    position: sticky;
    top: 0;
}
.hts-table th:first-child, .hts-table td:first-child { text-align: left; }
.hts-table tr:hover { background: rgba(255,255,255,0.05); }

/* 색상 유틸 */
.up { color: #e74c3c !important; }
.down { color: #3498db !important; }

/* 중앙 패널 */
.center-content { padding: 20px; display: flex; flex-direction: column; height: 100%; gap: 20px; }
.bot-controls { display: flex; gap: 15px; justify-content: center; }
.chart-placeholder {
    flex: 1;
    border: 1px dashed rgba(255,255,255,0.2);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #555;
    background: rgba(0,0,0,0.2);
}

/* 버튼 */
.obsidian-btn {
    padding: 12px 24px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: bold;
    font-size: 1rem;
    background: linear-gradient(145deg, #2c3e50, #1a252f);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e0e0e0;
    box-shadow: 3px 3px 6px rgba(0,0,0,0.4), inset 1px 1px 2px rgba(255,255,255,0.1);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}
.obsidian-btn.glow:hover {
    background: linear-gradient(145deg, #34495e, #2c3e50);
    box-shadow: 0 0 15px rgba(46, 204, 113, 0.6), inset 1px 1px 3px rgba(255,255,255,0.3);
    border-color: #2ecc71;
    transform: translateY(-2px);
    color: #fff;
}
.obsidian-btn.stop:hover {
    background: linear-gradient(145deg, #34495e, #2c3e50);
    box-shadow: 0 0 15px rgba(231, 76, 60, 0.6), inset 1px 1px 3px rgba(255,255,255,0.3);
    border-color: #e74c3c;
    transform: translateY(-2px);
    color: #fff;
}

/* 우측 패널 (계좌) */
.account-summary { padding: 20px; border-bottom: 1px solid rgba(255,255,255,0.05); }
.account-summary h3, .positions-container h3 { margin: 0 0 10px 0; font-size: 0.9rem; color: #888; }
.balance {
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    color: #fff;
    text-shadow: 0 0 10px rgba(46, 204, 113, 0.3);
}
.positions-container { padding: 20px; flex: 1; overflow-y: auto; }
#positions-list { list-style: none; padding: 0; margin: 0; }
.empty-msg { color: #555; font-style: italic; }

/* 하단 티커 */
.ticker-wrap {
    width: 100%;
    height: 40px;
    overflow: hidden;
    position: fixed;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    border-top: 1px solid rgba(255,255,255,0.05);
    border-radius: 0;
    background: #0f1519;
}
.ticker-move {
    display: flex;
    white-space: nowrap;
    /* 0.5배속 (30s -> 60s) */
    animation: tickerLeftToRight 60s linear infinite;
}
.ticker-item {
    padding: 0 40px;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 12px;
}
@keyframes tickerLeftToRight {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100vw); }
}

/* 스크롤바 커스텀 */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); }
::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: rgba(46, 204, 113, 0.5); }
